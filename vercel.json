{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": false },
    { "source": "/waitlist.html", "destination": "/waitlist", "permanent": false },
    { "source": "/contact.html", "destination": "/contact", "permanent": false },
    { "source": "/terms.html", "destination": "/terms", "permanent": false },
    { "source": "/privacy.html", "destination": "/privacy", "permanent": false },
    { "source": "/plans.html", "destination": "/plans", "permanent": false }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, noimageindex" }]
    }
  ]
}
